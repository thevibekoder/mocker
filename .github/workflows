name: Update Playlist Timestamps

on:
  # Run daily at 3 AM UTC
  schedule:
    - cron: '0 3 * * *'
  
  # Allow manual trigger from Actions tab
  workflow_dispatch:

jobs:
  process-playlist:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      
      - name: Install dependencies
        run: |
          pip install requests google-genai
      
      - name: Process playlist
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          TRANSCRIPT_API_KEY: ${{ secrets.TRANSCRIPT_API_KEY }}
          PLAYLIST_URL: ${{ vars.PLAYLIST_URL }}
        run: |
          cd scripts
          python process_playlist.py "$PLAYLIST_URL" --out-dir ../data
      
      - name: Build timestamp map
        run: |
          python build_mock_map.py --data-dir data --out data/mock-timestamp-map.json
      
      - name: Commit and push changes
        run: |
          git config user.name "GitHub Actions"
          git config user.email "actions@github.com"
          git add data/
          git diff --staged --quiet || git commit -m "Auto-update: process new playlist videos"
          git push
